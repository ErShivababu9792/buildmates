# Your Firebase project id (same as VITE_FIREBASE_PROJECT_ID in the web app)
FIREBASE_PROJECT_ID=
# Websites allowed to call this API, comma separated
ALLOWED_ORIGINS=http://localhost:5173
# Max requests per user per minute
RATE_LIMIT_PER_MIN=60

# ---------- Phase 11 ----------
# Firebase Admin key: Firebase Console → Project settings → Service accounts → Generate new private key.
# Save the downloaded file in this ai-api folder as serviceAccount.json (it is in .gitignore – never share it).
FIREBASE_SERVICE_ACCOUNT=serviceAccount.json

# Parent approval emails. Easiest for testing: Gmail + App Password (Google Account → Security → App passwords).
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=BuildMates
# For the live server use Brevo instead (free 300 emails/day): set BREVO_API_KEY and MAIL_FROM (a verified sender).
BREVO_API_KEY=
MAIL_FROM=
# Address of THIS server as parents will open it (live: your Hugging Face Space URL). Empty = the address the app used.
PUBLIC_SERVER_URL=

# College ID photos (kept private, deleted after checking): Cloudinary Dashboard → "API environment variable"
CLOUDINARY_URL=

# ---------- Phase 13 ----------
# Address of the web app (used for links inside emails). Live: https://your-app.vercel.app
APP_URL=http://localhost:5173
# Optional: lets a free scheduler (cron-job.org) send the weekly digest: GET /digest/cron?key=THIS_VALUE
DIGEST_CRON_KEY=

# ---------- Languages ----------
# nllb (default, free): Meta's NLLB-200 model on this server (~2.5 GB download once, needs ~3 GB free RAM)
# google: Google Cloud Translation API (set GOOGLE_TRANSLATE_KEY)
TRANSLATE_PROVIDER=nllb
GOOGLE_TRANSLATE_KEY=
