# Copy this file to ".env" and paste the values from
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup (Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Python AI API (Phase 3). Local: http://localhost:8000  ·  Live: your Hugging Face Space URL
# Leave empty to run without AI (the app uses built-in rules).
VITE_AI_API_URL=

# Profile photos (Phase 10) – free Cloudinary account, "unsigned" upload preset.
# Leave empty to keep initials only.
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=

# Phone notifications (Phase 11): Firebase Console → Project settings → Cloud Messaging →
# Web configuration → Web Push certificates → Generate key pair → copy the "Key pair".
VITE_FIREBASE_VAPID_KEY=
